---
layout: none
permalink: /search.json
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncate: 200 | jsonify }},
    "tipo": {{ post.tipo | default: "pro" | jsonify }},
    "type": "post",
    "date": {{ post.date | date: "%b %Y" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
{% if site.posts.size > 0 and site.projects.size > 0 %},{% endif %}
{% assign sorted_projects = site.projects | sort: "order" %}
{% for project in sorted_projects %}
  {
    "title": {{ project.title | jsonify }},
    "url": {{ project.url | relative_url | jsonify }},
    "excerpt": {{ project.description | default: "" | jsonify }},
    "category": {{ project.category | default: "" | jsonify }},
    "type": "project"
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
